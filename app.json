                 "version":  "1.0.3",
                 "icon":  "./assets/images/icon.png",
                 "android":  {
                                 "package":  "com.mikel.mydapp",
                                 "versionCode":  4,
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/images/adaptive-icon.png",
                                                      "backgroundColor":  "#121417"
                                                  }
                             },
                 "ios":  {
                             "bundleIdentifier":  "com.mikel.mydapp"
                         },
                 "plugins":  [
                                 [
                                     "expo-splash-screen",
                                     {
                                         "image":  "./assets/images/splash-icon.png",
