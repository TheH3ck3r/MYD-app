{
  "expo": {
    "name": "MYD",
    "slug": "myd-app",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.mikel.mydapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.mikel.mydapp"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
